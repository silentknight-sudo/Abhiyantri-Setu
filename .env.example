# Copy to .env for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Neon Postgres — use the POOLED connection string (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Your site's URL (no trailing slash)
BETTER_AUTH_URL="https://abhiyantrisetu.vercel.app"

# Google sign-in (optional — the Google button is disabled if these are empty)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Setu AI assistant (optional — /ai shows a "not configured" message without it)
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
